# Copy to .env and fill in real values.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-ingestion-host

# Google Maps SDK keys (read by app.config.ts, injected natively at prebuild).
# Enable "Maps SDK for Android" / "Maps SDK for iOS" and restrict the keys by
# package/bundle id (+ SHA-1 for Android).
GOOGLE_MAPS_ANDROID_API_KEY=your-google-maps-android-api-key
GOOGLE_MAPS_IOS_API_KEY=your-google-maps-ios-api-key
